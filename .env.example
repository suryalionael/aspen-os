# Supabase project credentials — obtain from your Supabase project settings (Settings > API).
# Copy this file to .env.local and fill in real values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (secret) key — Project Settings > API > "service_role" secret.
# Server-only: deliberately NOT prefixed with NEXT_PUBLIC_, so Next.js never
# bundles it into client code. Used by lib/supabase/admin.ts exclusively for
# self-account-deletion (lib/actions/account.ts) — never import that file
# from a Client Component or any browser-reachable code path.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — create a project at https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID for a Web application
# 2. Add the redirect URI (e.g. http://localhost:3000/api/auth/google/callback)
# 3. Enable the Google Drive API
# 4. Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from the client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encryption key for Google OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# Must be at least 32 characters long.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Aspen AI — OpenRouter configuration.
# Get an API key at https://openrouter.ai/keys
# Supported models: deepseek/deepseek-chat, qwen/qwen2.5-72b-instruct, kimi/kimi-vl-2025
OPENROUTER_API_KEY=
ASPEN_AI_MODEL=deepseek/deepseek-chat

# Google Drive Workspace Root Folder.
# All Drive operations are restricted to this folder and its descendants.
# Find the folder ID in the URL: https://drive.google.com/drive/folders/{FOLDER_ID}
ASPEN_GOOGLE_DRIVE_ROOT_FOLDER_ID=
